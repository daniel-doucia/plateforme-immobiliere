APP_NAME="ImmoTchad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.td
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=immotchad
DB_USERNAME=immotchad
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Jamais « faux » en production : renseignez le fournisseur réel une fois branché
PAIEMENT_FOURNISSEUR=
ANNONCES_PHOTO_OBLIGATOIRE=true

# Derrière un proxy : * (seulement si le serveur n'est joignable que par le proxy) ou une liste d'adresses
TRUSTED_PROXIES=

# Uniquement pour la première installation : à SUPPRIMER du fichier après la création du compte administrateur
ADMIN_EMAIL=
ADMIN_PASSWORD=
